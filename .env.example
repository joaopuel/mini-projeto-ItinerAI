GROQ_API_KEY=

# Modelo Groq usado pelo agente e pela extração. Opcional; padrão: openai/gpt-oss-120b
GROQ_MODEL=openai/gpt-oss-120b

# Temperatura do LLM do agente (0 = mais determinístico). Opcional; padrão: 0.7
# (a extração usa temperature=0 fixo, independente desta variável)
GROQ_TEMPERATURE=0.7

# Timeout (em segundos) das requisições HTTP à Wikipédia. Opcional; padrão: 10
WIKIPEDIA_TIMEOUT=10

# Nível dos logs estruturados em logs/itinerai.log (DEBUG/INFO/WARNING/ERROR). Opcional; padrão: INFO
LOG_LEVEL=INFO

# --- Automação low-code: envio do roteiro por e-mail via n8n (opcional) ---
# Sem N8N_WEBHOOK_URL, o agente NÃO faz nenhuma chamada externa: a oferta de envio
# degrada silenciosamente e o roteiro segue disponível em output/.
# URL de produção do webhook (importe docs/low-code/n8n-workflow.json no n8n e ative o fluxo)
N8N_WEBHOOK_URL=
# Valor do header X-ItinerAI-Token, igual ao da credencial "ItinerAI Webhook Token" no n8n
N8N_WEBHOOK_TOKEN=
# Timeout (em segundos) da chamada ao webhook. Opcional; padrão: 10
N8N_TIMEOUT=10

# Espelhar os logs também no stderr, além do arquivo (para depuração). Opcional; padrão: desligado
# LOG_TO_STDERR=false
