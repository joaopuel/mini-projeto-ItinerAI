GROQ_API_KEY=

# Modelo Groq usado pelo agente e pela extração. Opcional; padrão: openai/gpt-oss-120b
GROQ_MODEL=openai/gpt-oss-120b

# Temperatura do LLM do agente (0 = mais determinístico). Opcional; padrão: 0.7
# (a extração usa temperature=0 fixo, independente desta variável)
GROQ_TEMPERATURE=0.7

# Timeout (em segundos) das requisições HTTP à Wikipédia. Opcional; padrão: 10
WIKIPEDIA_TIMEOUT=10
